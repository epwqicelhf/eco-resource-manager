# Auto-generated .gitignore

# OS files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project

# Environment / Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
build/
out/
target/

# Temp files
*.tmp
*.temp
.tmp/
temp/

# Cache
.cache/
.parcel-cache/
.turbo/

# Node.js
node_modules/
coverage/
.nyc_output/
.npm
npm-debug.log*
yarn-error.log*
.yarn/
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnp.*
